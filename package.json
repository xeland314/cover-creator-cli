{
  "name": "cover-creator-cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Cover Creator por línea de comandos: renderiza carruseles (PNG/JPG) reutilizando los componentes React del portafolio, con estilo pixel-art opcional.",
  "bin": { "cc": "bin/cc.mjs" },
  "scripts": {
    "build": "vite build",
