    "themes": "node bin/cc.mjs themes"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "prism-react-renderer": "^2.4.1",
    "puppeteer-core": "^25.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0"
  }
}
